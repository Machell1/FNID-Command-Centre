# FNID Command Centre v2.0 - Environment Configuration
# Copy to .env and fill in production values

# Flask
FLASK_APP=src.fnid_portal
FLASK_ENV=production
FNID_SECRET_KEY=your-256-bit-secret-key-here-change-in-production

# Database
DATABASE_URL=postgresql://fnid_user:strong_password@postgres:5432/fnid_db
FNID_DB_PATH=/app/data/fnid.db

# Redis (Caching & Celery)
REDIS_URL=redis://redis:6379/0

# Security
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_EXPIRES=28800
BCRYPT_LOG_ROUNDS=12

# File Storage
FNID_UPLOAD_DIR=/app/data/uploads
FNID_EXPORT_DIR=/app/data/exports
MAX_CONTENT_LENGTH=16777216

# S3 (Evidence Storage)
S3_ENDPOINT_URL=https://s3.jcf.gov.jm
S3_BUCKET_NAME=fnid-evidence
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# Audit & Monitoring
SENTRY_DSN=https://your-sentry-dsn
PROMETHEUS_PORT=9090

# JCF Integration
JCF_AD_SERVER=ldap://jcf-ad.jcf.gov.jm
JCF_AD_DOMAIN=jcf.gov.jm

# FNID Area 3
FNID_AREA_CODE=A3
FNID_DIVISIONS=M,SE,C
